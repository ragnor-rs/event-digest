TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE_NUMBER=your_phone_number_here
OPENAI_API_KEY=your_openai_api_key_here

# Local Telegram archive mined by `scripts/discover-sources.ts discover` (source
# discovery step 1). Optional — only the discovery scripts read it, and the
# digest itself runs without it.
#
# There is deliberately no default: an export lives wherever its owner put it,
# usually outside this repo, so any default would be one machine's layout baked
# into a shared file.
#
# Create an archive with:  npx ts-node scripts/export-telegram.ts
# Or point at an existing Telegram Desktop JSON export converted to SQLite.
TELEGRAM_ARCHIVE_DB=/path/to/telegram.db